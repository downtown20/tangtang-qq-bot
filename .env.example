# 环境变量配置（复制为 .env 并填写；也可以完全不管它——
#  控制台「🔑 密钥管理」页会直接写这个文件）
#
# 这些变量名要和 config.yaml 里的 ${...} 引用对上：
#    config.yaml                        .env 里的变量
#    llm.api_key                        DEEPSEEK_KEY（换 provider 见下）
#    llm.seductive_api_key              SEDUCTIVE_KEY
#    llm.vision.api_key                 QWEN_KEY
#    napcat.access_token                SNOWLUMA_TOKEN
#
# 换 LLM 供应商时按 provider 选对应的那一个（控制台选完会自动写）：
#    deepseek→DEEPSEEK_KEY   openai→OPENAI_KEY   xai→XAI_KEY
#    anthropic→ANTHROPIC_KEY custom→CUSTOM_LLM_KEY
#
# 值不要加引号，也不要在行尾写注释——本文件按 KEY=VALUE 逐行读。

# 必须：糖糖的「大脑」（DeepSeek / Claude / GPT / Grok…）
DEEPSEEK_KEY=
# 可选：专用模型的独立 Key（不填则复用上面的 key）
SEDUCTIVE_KEY=
# 可选：识图选「云端千问 VL」时才需要；选本地视觉模型不用填
QWEN_KEY=
# 可选：只有用了 SnowLuma / OneBot 的授权 Token 才要填——
#   与 SnowLuma 网页面板里那一栏「授权 Token」完全一样才能连上；
#   面板里没设 Token 的话，这里也留空。
SNOWLUMA_TOKEN=
# 换供应商才用得到（用哪个填哪个，其余留空即可）
OPENAI_KEY=
XAI_KEY=
ANTHROPIC_KEY=
CUSTOM_LLM_KEY=
# 可选：LLM 端点覆盖（agent/handler.py 读取；仅 provider=deepseek 且填了才生效）
DEEPSEEK_BASE_URL=
# 可选：控制台「图库打标」走云端 API 时的 Key（走本地 ollama 不用填）
IMAGE_TAG_API_KEY=
