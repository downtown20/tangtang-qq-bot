# ═══════════════════════════════════════════════════════════
# 小糖糖 · .gitignore
# 原则：仓库只放「源头」——代码、文档、配置模板。
#       依赖、模型、语音/贴图资源、数据库、日志、构建产物一律不进库。
#       派生数据（索引/缓存）也不进库——2026-09-19 事故：
#       knowledge/*.md 的本机路径清干净了，索引 sqlite 里的旧副本却随包发了出去。
# ═══════════════════════════════════════════════════════════

# ── 密钥（最高优先，任何情况都不提交）─────────────────────
.env
.env.*
config.yaml
config.yaml.*
*.key
*.pem
# 配置模板必须能进库（2026-10-26 根目录规范化：让 clone 下来的人知道该填哪些键）。
# `.env.*` 会把 `.env.example` 一起挡掉——否定规则必须写在排除规则**后面**才生效。
!config.example.yaml
!.env.example

# ── 运行时状态（每台机器各自生成，重启语义靠它们落盘）──────
# 2026-10-15 T55-F 根目录规范化：16 条逐文件规则收口成目录级规则。
# 逐文件写法的代价是「每加一个状态文件都要记得补一行」，漏一行就是一次隐私
# 随包泄漏（教训 #31 同族：白名单要穷举该扫的，不是穷举能想到的）。
状态/
# 唯一留在根的状态标记文件（零引用，见 T55-F 报告；只忽略、不动）
.build_complete

# ── 数据库（体积大 + 含全部聊天隐私，绝不入库）─────────────
*.db
*.db-shm
*.db-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
memory_sync/
backups/

# ── 日志 ──────────────────────────────────────────────────
# 2026-10-15 T55-F：日志收进 日志/ 目录——tangtang.log 与它按天轮转出来的
# 副本（tangtang.log.YYYY-MM-DD）都在那里。
日志/
# 审查工作的原始 CLI 转储（2026-10-15 主人拍板 ②A）：
#   docs/审查/ 共 46 文件，其中 *.log + *_result.txt ≈ 5.5 MB 是 Codex 的原始输出，
#   含 180 处本机绝对路径。有文档价值的是同目录的 *.md 审查报告，那些照常入库。
docs/审查/*.log
docs/审查/*_result.txt

# ── 依赖与模型（数 GB，clone 后由安装脚本拉取）──────────────
依赖/
python310/
models/
asr_models/
assets/
gpt-sovits/
SnowLuma/
米雪儿gpt-sovits模型/

# ── 语音与贴图资源（著作权 + 体积）────────────────────────
# 唱歌音频：完整曲库 41 首 / 5.58 GB 不进库；只挑 4 首代表作随仓库发出，
# 让克隆下来就能点歌试听（2026-10-15 主人拍板 ①C）。
# gitignore 的否定规则要求父目录先被放行，所以是「先忽略全部、再逐级放行」的写法。
songs/*
!songs/audio
songs/audio/*
!songs/audio/光年之外.wav
!songs/audio/Lemon.wav
!songs/audio/晴天.wav
!songs/audio/secret base ~君がくれたもの~ (10 years after Ver.).wav
# 摆放说明/目录说明（*.md）要能进库（2026-10-26）：音频与图片一个都不进，但
# 「往这里放什么、怎么命名」的说明必须随仓库发出，否则 clone 的人只能靠猜。
!songs/**/*.md
音频/
voice_cache/
# 贴图目录同理，但**不能**写成 `stickers/`：git 的规则是「父目录被排除时 `!` 无法再
# 包含其中的文件」，写成目录就是一条惰性否定（2026-09-19 三个落点说明从未进库的同一个
# 坑，见 tests/test_release_sanitizer.py::test_scaffold_notes_survive_gitignore）。
# 排除「目录内容」→ 顶层 *.md 说明能进库，图片仍然一个都不进。
stickers/*
!stickers/*.md
stickers_cg/*
!stickers_cg/*.md
stickers_michele/*
!stickers_michele/*.md
stickers_murasame/*
!stickers_murasame/*.md
share_images/
Imag/

# ── 构建产物 / 缓存 / 索引（派生数据，可重建）──────────────
__pycache__/
*.py[cod]
.pytest_cache/
# 测试的仓库内临时落点（2026-10-15 T55：test_drives_series 的 csv_guard 把 CSV 指到
# tests/_tmp/<唯一名>/——必须留在仓库内，因为 append_drives_series() 的返回值里有
# _DRIVES_SERIES.relative_to(ROOT)。正常 teardown 会清空，崩溃时会留残渣，故忽略）
tests/_tmp/

# 长期优化快照 = 派生数据（tools/长期优化快照.py 每次运行生成一份），且 :438 会把
# COMPUTERNAME 写进 "host" 字段——留在公开库里等于每跑一次就重新泄露一次主机名。
# 按 CLAUDE.md 教训 #32「发布物只放源头，派生数据不进包」排除；它在两机之间仍靠
# Syncthing 同步（见 docs/用户手册/文件同步指南.md），棘轮对比照常工作。
docs/开发规划/长期优化/快照/
.gitnexus/
artifacts/
runtime-observations/
.uv-cache*/
.trash/
_backups/
.stfolder/
.archify/

# ── 一次性产物与临时文件（2026-10-14 T54-B 归置）──────────
# 旧规则只有 *.bak-*，漏掉 main.py.bak 这类无标签命名
*.bak
*.bak-*
*.bak_*
_tmp_*
tmp_*.png
# TTS 试听临时音频（语音合成失败时残留在根目录，2026-10-26 清出 11.6MB）
*.pcm
_clip_a*.png
_tmp_shots/
temp_files/
generated_images/

# ── 内部协作工作区（原始转录，不是项目文档）──────────────
# 依据：2026-10-15 全库扫描——docs/协作/logs/ = 53 文件 / 41.6 MB，
#   含 4,309 处本机绝对路径（单文件 codex_exec_L1.log 就 3,515 处）。
#   这是 CLAUDE.md 教训 #30「本机路径随包发出」的同族：仓库是公开的，
#   原始 CLI 转录既没有文档价值，又把机器布局摊了出去。文件仍留在本地。
docs/协作/logs/

# ── 可重下发的第三方二进制（tools/ 内，非本项目产物）──────
# 依据：docs/发布/发布清单_v1_20260905.md:20 的发布规格本就排除「cloudflared*.exe 52M」；
# tools/ 与 agent/ 全库零引用（不是运行时依赖，是内网穿透实验遗留）；T54 大件盘点标注「可重建（可重下）」
cloudflared*.exe
*.zip
*.7z
*.tar.gz

# ── 私密内容（2026-10-26 主人明确要求：本地私密的一律不上传）──────────
# 依据原话：「本地涉及私密内容的都不允许上传，包括亲密模式的场景卡中的内容、
#   特殊CG图片和对应标签等等」。
# 这些文件**已经从索引移除**（`git rm --cached`，本地文件还在）——
# 只加 ignore 不够：已经在索引里的文件，ignore 规则对它无效，必须显式移除。
#
# ⚠ 历史里仍然留有它们（建仓提交 1aa9339）。要让公开仓库彻底干净，
#   只能重写历史（git filter-repo / 删仓库重建），不是这一行能解决的。

# 亲密模式的场景卡（私人的亲密/性相关设定）
scenarios/seductive.yaml
# 亲密模式范本包：露骨文案原文，绝不进公开库
knowledge/色色参考/
# DSH 的项目记忆（工具产物，里面有聊天内容摘录，不是项目文档）
.dsh-memory/
# 记忆冲突存档（真实聊天记录派生）
tools/_归档/记忆冲突存档*.json
# 协议覆盖层 `prompts/` **已入库**（2026-10-26 根目录规范化，主人反馈「内容不全」）：
# 23 个文件逐个复核过私密词（色色/亲密模式/QQ 号/真名）——唯一命中的 `亲密聊天` 是
# 心情枚举，`agent/mood.py:32` 与 `agent/protocols.py:1304` 里本来就有；正文与
# protocols.py 默认值一致由 tests/test_prompt_overrides.py 钉住。
# 它是行为核心：不进库，clone 下来拿到的是内置默认而不是这套调好的协议（静默变差）。
# 不要再把这一行加回来。

# ── 打标环境与缓存（2026-10-26 第 63 轮）────────────────────
# `venv_tagger/` 是打标脚本的独立虚拟环境（126 MB，含 torch/PIL），
# 由安装脚本重建；`gem` 一样的东西进了库就是一次不可撤销的灾难。
# `tangtang-thumbs/` 26 MB 缩略图缓存、`tmp_dsh_ui/` 16 MB 临时渲染产物，
# 都能重生成。`jieba.cache` 分词缓存同理。
venv_tagger/
tangtang-thumbs/
tmp_dsh_ui/
jieba.cache
_probe/
# data/ 是外部工具留下的运行时产物（审核清单 / 意见收集），不是项目源码
data/
data/**

# ── 编辑器 / 系统 ────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini