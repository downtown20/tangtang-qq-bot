{
  "target": "agent/memory.py",
  "tests": "tests/test_uncertain_injection.py",
  "mutations": [
    {
      "name": "M1-去掉模糊标记（把 💭~ 换成 💭，两档看起来一样）",
      "old": "facts.append(f\"  {_protocols.UNCERTAIN_MARK} {v[:80]}\")",
      "new": "facts.append(f\"  💭 {v[:80]}\")",
      "expect_fail": "test_uncertain_entry_gets_tilde"
    },
    {
      "name": "M2-去掉块尾行为契约（标记成了装饰）",
      "old": "        if uncertain_lines:\n            lines.append(f\"  {_protocols.UNCERTAIN_MEMORY_CONTRACT}\")",
      "new": "        if uncertain_lines:\n            pass",
      "expect_fail": "test_uncertain_entry_gets_tilde"
    },
    {
      "name": "M3-可信档也加标记（全都加 = 双向断言失效）",
      "old": "                        facts.append(f\"  💭 {v[:80]}\")",
      "new": "                        facts.append(f\"  {_protocols.UNCERTAIN_MARK} {v[:80]}\")",
      "expect_fail": "test_trusted_entry_has_no_tilde"
    },
    {
      "name": "M4-is_uncertain 恒真（判定不再看 trust_level）",
      "old": "        level = str(getattr(entry, \"trust_level\", \"\") or \"\").strip()\n        return level not in TRUSTED_TRUST_LEVELS",
      "new": "        return True",
      "expect_fail": "test_trusted_entry_has_no_tilde"
    }
  ]
}
