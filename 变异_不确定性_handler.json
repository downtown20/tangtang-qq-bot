      "old": "                top_k=_protocols.UNCERTAIN_INJECT_MAX,",
      "new": "                top_k=99,",
      "expect_fail": "test_merge_keeps_trusted_first_and_uncertain_separate"
    },
    {
      "name": "M6-合并顺序反转（模糊排到可信前面）",
