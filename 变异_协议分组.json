{
  "target": "agent/prompt_overrides.py",
  "tests": "tests/test_prompt_groups.py",
  "mutations": [
    {
      "name": "组标题又回到读文件头（改了不生效；两个不同 key 撞名就合并）",
      "old": "            \"group_title\": titles.get(group) or \"未分组\",",
      "new": "            \"group_title\": str(meta.get(\"group_title\") or titles.get(group) or \"未分组\"),",
      "expect_fail": "test_group_title_in_file_header_is_ignored"
    },
    {
      "name": "拼错的 group 静默当成正常组（界面不标红，用户以为改成功了）",
      "old": "        known = group in titles",
      "new": "        known = True",
      "expect_fail": "test_unknown_group_key_is_flagged"
    },
    {
      "name": "不按组排序（同一组被拆成多段，界面顺序乱）",
      "old": "    rows.sort(key=lambda r: order.get(r[\"group\"], len(order)))",
      "new": "    pass",
      "expect_fail": "test_each_group_is_one_contiguous_block"
    },
    {
      "name": "组表缺失时不回落（界面上一片「未分组」）",
      "old": "        if not GROUPS_PATH.is_file():\n            return fallback",
      "new": "        if not GROUPS_PATH.is_file():\n            return []",
      "expect_fail": "test_read_groups_falls_back_when_file_missing"
    },
    {
      "name": "YAML 坏掉就抛异常（一次手误让她发不出消息）",
      "old": "    except Exception:  # YAML 语法错/权限/编码 —— 一律回落，启动路径不许崩\n        return fallback",
      "new": "    except ZeroDivisionError:\n        return fallback",
      "expect_fail": "test_read_groups_survives_broken_yaml"
    },
    {
      "name": "标题不转义（含 # 的标题被 YAML 当注释切掉）",
      "old": "    rendered = f\"{field_indent}title: {_yaml_scalar(title)}\"",
      "new": "    rendered = f\"{field_indent}title: {title}\"",
      "expect_fail": "test_replace_group_title_quotes_special_chars"
    },
    {
      "name": "stale_group_title 恒 False（文件头里的旧字段静默失效没人知道）",
      "old": "            \"stale_group_title\": \"group_title\" in meta,",
      "new": "            \"stale_group_title\": False,",
      "expect_fail": "test_group_title_in_file_header_is_ignored"
    }
  ]
}