{
  "target": "tools/回挂记忆证据.py",
  "tests": "tests/test_evidence_backfill_tool.py",
  "mutations": [
    {
      "name": "B1-去掉锚点最小长度门",
      "old": "    if len(value) < min_chars:",
      "new": "    if False:",
      "expect_fail": "test_short_anchor_is_refused"
    },
    {
      "name": "B2-跨群歧义不再放弃",
      "old": "    elif len(groups) > 1:\n        # 同一句话横跨多个场景：无法确定记忆来自哪个群，而回挂会把\n        # source_group_id 一并钉死——猜错就是给记忆安错来源。放弃。\n        return {\"status\": \"ambiguous\", \"anchor\": value, \"groups\": sorted(groups)}",
      "new": "    elif False:\n        return {\"status\": \"ambiguous\", \"anchor\": value, \"groups\": sorted(groups)}",
      "expect_fail": "test_same_sentence_across_two_groups_is_ambiguous"
    },
    {
      "name": "B3-声明群不匹配也算命中",
      "old": "        if not scoped:\n            # 记忆声明了自己来自某个群，但那句话不在该群 → 不是同一条语境\n            return {\"status\": \"unmatched\", \"anchor\": value, \"reason\": \"group_mismatch\"}",
      "new": "        if not scoped:\n            scoped = hits",
      "expect_fail": "test_declared_group_mismatch_is_not_linked"
    },
    {
      "name": "B4-预演也写库",
      "old": "            if not apply:\n                entry[\"dry_run\"] = \"would_land\"\n                _keep(samples, entry)\n                continue",
      "new": "            if False:\n                entry[\"dry_run\"] = \"would_land\"\n                _keep(samples, entry)\n                continue"
    },
    {
      "name": "B5-候选不排除已可信（幂等失效）",
      "old": "        f\"COALESCE(trust_level,'legacy_unverified') NOT IN ({marks})\",",
      "new": "        \"1=1\","
    },
    {
      "name": "B6-回滚不按批次隔离",
      "old": "            \"WHERE e.reviewer IN (?,?) \"",
      "new": "            \"WHERE (e.reviewer IN (?,?) OR 1=1) \"",
      "expect_fail": "test_rollback_only_touches_its_own_batch"
    },
    {
      "name": "B7-糖糖自己的话也当证据",
      "old": "        \"FROM chat_log WHERE qq_id=? AND COALESCE(is_bot_reply,0)=0 \"",
      "new": "        \"FROM chat_log WHERE qq_id=? \"",
      "expect_fail": "test_bot_reply_is_not_evidence"
    },
    {
      "name": "B8-importance门槛不生效（小批次变成全量）",
      "old": "    if min_importance > 0:\n        conditions.append(\"COALESCE(importance,0)>=?\")\n        params.append(int(min_importance))",
      "new": "    if False:\n        conditions.append(\"COALESCE(importance,0)>=?\")\n        params.append(int(min_importance))",
      "expect_fail": "test_min_importance_filter_skips_low_importance"
    },
    {
      "name": "B9-回滚不还原source_group_id",
      "old": "    restore_fields = {\n        \"evidence_ids\": \"evidence_ids_restored\",\n        \"source_group_id\": \"source_group_restored\",\n    }",
      "new": "    restore_fields = {\n        \"evidence_ids\": \"evidence_ids_restored\",\n    }",
      "expect_fail": "test_rollback_restores_source_group_id"
    }
  ]
}
